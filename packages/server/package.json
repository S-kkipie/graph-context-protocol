{
    "name": "@graph-context-protocol/server",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "@ai-do/source": "./src/index.ts",
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./package.json": "./package.json"
    },
    "nx": {
        "name": "server",
        "targets": {
            "test": {
                "command": "vitest run",
                "options": {
                    "cwd": "packages/server"
                }
            },
            "typecheck": {
                "command": "tsc --build --noEmit",
                "options": {
                    "cwd": "packages/server"
                }
            }
        }
    },
    "dependencies": {
        "@graph-context-protocol/core": "workspace:*",
        "zod": "^4.4.3"
    }
}
