{
    "name": "server-demo",
    "version": "0.0.1",
    "private": true,
    "nx": {
        "targets": {
            "build": {
                "executor": "@nx/esbuild:esbuild",
                "outputs": [
                    "{options.outputPath}"
                ],
                "defaultConfiguration": "production",
                "options": {
                    "platform": "node",
                    "outputPath": "apps/server-demo/dist",
                    "format": [
                        "cjs"
                    ],
                    "bundle": true,
                    "main": "apps/server-demo/src/main.ts",
                    "tsConfig": "apps/server-demo/tsconfig.app.json",
                    "assets": [
                        "apps/server-demo/src/assets"
                    ],
                    "thirdParty": false,
                    "esbuildOptions": {
                        "sourcemap": true,
                        "outExtension": {
                            ".js": ".js"
                        }
                    }
                },
                "configurations": {
                    "development": {},
                    "production": {
                        "esbuildOptions": {
                            "sourcemap": false,
                            "outExtension": {
                                ".js": ".js"
                            }
                        }
                    }
                }
            },
            "serve": {
                "continuous": true,
                "executor": "@nx/js:node",
                "defaultConfiguration": "development",
                "dependsOn": [
                    "build"
                ],
                "options": {
                    "buildTarget": "server-demo:build",
                    "runBuildTargetDependencies": false
                },
                "configurations": {
                    "development": {
                        "buildTarget": "server-demo:build:development"
                    },
                    "production": {
                        "buildTarget": "server-demo:build:production"
                    }
                }
            },
            "test": {
                "executor": "@nx/vite:test",
                "outputs": [
                    "{options.reportsDirectory}"
                ],
                "options": {
                    "config": "apps/server-demo/vitest.config.mts"
                }
            }
        }
    },
    "dependencies": {
        "@graph-context-protocol/core": "workspace:*",
        "@graph-context-protocol/server": "workspace:*",
        "express": "^5.2.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/express": "^5.0.6"
    }
}
